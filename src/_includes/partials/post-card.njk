{% set postComments = comments[post.data.postSlug] %}
<article class="post-card hentry">
  <header class="entry-header">
    <h2 class="entry-title"><a href="{{ post.url }}" rel="bookmark">{{ post.data.title }}</a></h2>
    <div class="entry-meta">
      <span class="posted-on"><a href="{{ post.url }}" rel="bookmark"><time datetime="{{ post.data.date | isoDate }}">{{ post.data.date | readableDate }}</time></a></span>
      <span class="byline"><span class="author vcard"><a class="url fn n" href="/author/admin/">{{ post.data.author }}</a></span></span>
      <span class="comments-link"><a href="{{ post.url }}#comments">{% if postComments and postComments.count > 0 %}{{ postComments.count }} {% if postComments.count == 1 %}Comment{% else %}Comments{% endif %}{% else %}Leave a comment{% endif %}</a></span>
    </div>
  </header>
  <div class="entry-content">
    {{ post | postTeaser | safe }}
  </div>
</article>
