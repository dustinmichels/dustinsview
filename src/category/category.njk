---
layout: layouts/base.njk
pagination:
  data: collections.categoryList
  size: 1
  alias: categoryData
permalink: "/category/{{ categoryData.slug }}/"
eleventyComputed:
  title: "Category: {{ categoryData.name }}"
---

<header class="page-header">
  <h1 class="page-title">Category: {{ categoryData.name }}</h1>
  <p class="text-muted">{{ categoryData.posts.length }} {% if categoryData.posts.length == 1 %}post{% else %}posts{% endif %} in this category.</p>
</header>

<section class="posts-section" aria-label="Posts in category {{ categoryData.name }}">
  <div class="post-list">
    {% for post in categoryData.posts %}
      {% include "partials/post-card.njk" %}
    {% endfor %}
  </div>
</section>

<nav class="categories-nav" aria-label="All Categories">
  <hr>
  <h3>All Categories</h3>
  <div class="taxonomies-cloud">
    {% for cat in collections.categoryList %}
    <a href="/category/{{ cat.slug }}/" class="badge {% if cat.slug == categoryData.slug %}badge-category{% endif %}">{{ cat.name }} ({{ cat.posts.length }})</a>
    {% endfor %}
  </div>
</nav>
