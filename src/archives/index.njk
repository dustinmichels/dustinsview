---
layout: layouts/base.njk
title: Archives
permalink: /archives/
---

<header class="page-header">
  <h1 class="page-title">Blog Archives</h1>
  <p class="text-muted">Browse all {{ collections.posts.length }} posts published between 2010 and 2018, grouped chronologically by year.</p>
</header>

<div class="archives-year-nav">
  <h2>Jump to Year</h2>
  <div class="taxonomies-cloud">
    {% for y in collections.yearList %}
    <a href="#year-{{ y.year }}" class="badge">{{ y.year }} ({{ y.posts.length }})</a>
    {% endfor %}
  </div>
</div>

<hr>

{% for y in collections.yearList %}
<section class="archive-year-section" id="year-{{ y.year }}">
  <h2 class="archive-year-heading"><a href="/{{ y.year }}/">{{ y.year }}</a> <small class="text-muted">({{ y.posts.length }})</small></h2>
  <ul class="archive-posts-table">
    {% for post in y.posts %}
    <li class="archive-post-row">
      <span class="archive-post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></span>
      <time class="archive-post-date" datetime="{{ post.data.date | isoDate }}">{{ post.data.date | readableDate("LLL d") }}</time>
    </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}
