---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tagData
permalink: "/tag/{{ tagData.slug }}/"
eleventyComputed:
  title: "Tag: #{{ tagData.name }}"
---

<header class="page-header">
  <h1 class="page-title">Tag: #{{ tagData.name }}</h1>
  <p class="text-muted">{{ tagData.posts.length }} {% if tagData.posts.length == 1 %}post{% else %}posts{% endif %} tagged with #{{ tagData.name }}.</p>
</header>

<section class="posts-section" aria-label="Posts tagged with {{ tagData.name }}">
  <div class="post-list">
    {% for post in tagData.posts %}
      {% include "partials/post-card.njk" %}
    {% endfor %}
  </div>
</section>

<nav class="tags-nav" aria-label="Browse Tags">
  <hr>
  <p><a href="/topics/">&larr; Back to Topics &amp; Categories</a></p>
</nav>
